# ==============================================================================
# SMARTDOC MONOREPO ENVIRONMENT TEMPLATE
# ==============================================================================

# --- LINE Messaging API Configuration ---
CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
CHANNEL_SECRET=your_line_channel_secret_here

# --- Neo4j Knowledge Graph Configuration ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password1234
NEO4J_DATABASE=neo4j

# --- Document & Storage Configuration ---
PDF_PATH=documents.pdf
VECTOR_STORE_TYPE=chroma
CHROMA_PATH=chatbot/data/chroma_db
FAISS_PATH=chatbot/data/faiss_index

# --- Model & Retrieval Configuration (Production Grade A) ---
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=BAAI/bge-m3
EMBED_DEVICE=cpu

# --- Hybrid Fusion & Reranking Strategy ---
# RERANKER_ENABLED: false = ใช้ Pure Reciprocal Rank Fusion (RRF) ตามเกณฑ์รูบิก โดยไม่ใช้โมเดล Re-ranker
RERANKER_ENABLED=false
RERANKER_MODEL=""
FUSION_ALGORITHM=rrf
RRF_K=60
DENSE_WEIGHT=0.5
SPARSE_WEIGHT=0.5

# --- Dynamic Top-k & Context Window Budget ---
TOP_K=5
MIN_TOP_K=3
MAX_TOP_K=8
MAX_CONTEXT_TOKENS=2200

# --- Guardrails Configuration ---
STRICT_CONTEXT_CHECK=true
MIN_SIMILARITY_THRESHOLD=0.05

# --- Server & Webhook Configuration ---
WEBHOOK_PORT=5000
